// Guardian — Database Schema (v0.1)
// See docs/ARCHITECTURE.md §3 and §6 for the reasoning behind these models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth (NextAuth.js standard models) + Users
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ANALYST
  ADMINISTRATOR
}

enum ProtectionMode {
  ANGEL_WATCH
  ARCHANGEL
}

enum DeviceStatus {
  ACTIVE
  PAUSED
  OFFLINE
  REVOKED
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String? // null for OAuth-only accounts
  name          String?
  image         String?
  role          Role      @default(USER)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  accounts         Account[]
  sessions         Session[]
  investigations   Investigation[]
  files            File[]
  notifications    Notification[]
  activityLogs     ActivityLog[]
  protectedDevices ProtectedDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────
// Organizations & Subscriptions (Team / Enterprise foundation)
// ─────────────────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Organization {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  members        User[]
  subscription   Subscription?
  investigations Investigation[]
  activityLogs   ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Investigations — the core object
// ─────────────────────────────────────────────────────────────────────────

enum InvestigationType {
  URL
  SCREENSHOT
  PDF
  IMAGE
  TEXT
  WHATSAPP
}

enum InvestigationStatus {
  PENDING
  COLLECTING_EVIDENCE
  ANALYZING
  COMPLETED
  FAILED
}

model Investigation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  type          InvestigationType
  status        InvestigationStatus @default(PENDING)
  inputText     String?             @db.Text // raw URL / pasted text / WhatsApp message
  failureReason String?

  files       File[]
  evidence    Evidence[]
  riskSignals RiskSignal[]
  aiAnalyses  AIAnalysis[]
  report      Report?

  // Evidence Graph (Phase 2a — ADR 0001) — additive, see below
  entities             Entity[]
  observations         Observation[]
  findings             Finding[]
  hypotheses           Hypothesis[]
  outstandingQuestions OutstandingQuestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([organizationId])
}

// Protected devices — Angel Watch / Archangel
model ProtectedDevice {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name     String
  platform String?
  mode     ProtectionMode @default(ANGEL_WATCH)
  status   DeviceStatus   @default(ACTIVE)

  lastSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}

// ─────────────────────────────────────────────────────────────────────────
// Files & Evidence
// ─────────────────────────────────────────────────────────────────────────

model File {
  id              String         @id @default(cuid())
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename   String
  mimeType   String
  sizeBytes  Int
  storageKey String // path/key within the configured StorageService
  storageUrl String? // public/signed URL, if applicable

  uploadedAt DateTime @default(now())

  @@index([investigationId])
}

enum EvidenceKind {
  TEXT_EXTRACT
  OCR_RESULT
  WEBPAGE_CONTENT
  METADATA
  WHOIS_RECORD
  DNS_RECORD
  SCREENSHOT_ANALYSIS
}

model Evidence {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  kind       EvidenceKind
  content    Json // normalized payload — shape depends on `kind`
  sourceRef  String? // e.g. file id, URL, or "user-input"
  confidence Float        @default(1.0) // 0–1, how much the agent trusts this evidence

  observations Observation[] // Phase 2a — ADR 0001

  createdAt DateTime @default(now())

  @@index([investigationId, kind])
}

// ─────────────────────────────────────────────────────────────────────────
// Company / Domain intelligence (compounds across investigations over time)
// ─────────────────────────────────────────────────────────────────────────

model Company {
  id               String   @id @default(cuid())
  name             String
  knownAliases     String[]
  registrationInfo Json? // registration numbers, jurisdictions, etc.
  domains          Domain[]

  entityReferences EntityReference[] // Phase 2a — ADR 0001

  firstSeenAt    DateTime  @default(now())
  lastVerifiedAt DateTime?

  @@index([name])
}

model Domain {
  id        String   @id @default(cuid())
  domain    String   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  entityReferences EntityReference[] // Phase 2a — ADR 0001

  registeredAt DateTime?
  registrar    String?
  sslValid     Boolean?
  whoisData    Json?
  riskFlags    String[]

  lastCheckedAt DateTime @default(now())

  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────
// Evidence Graph (Phase 2a — see docs/decisions/0001-evidence-graph-data-semantics.md)
// Entity/EntityReference/Observation/Finding/Hypothesis/OutstandingQuestion are additive.
// EntityRelationship is intentionally NOT added yet — no producer in Phase 2a (ADR 0001 §3).
// ─────────────────────────────────────────────────────────────────────────

model Entity {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  type         String // "domain" | "company" — Phase 2a's only two types (ADR 0001 §3)
  label        String // display label; redacted if it's a data-subject PII field
  canonicalKey String // normalized natural key, scoped to this investigation only in Phase 2a —
  // NOT used for cross-investigation matching yet (ADR 0001 §2)
  attributes   Json

  references EntityReference[]

  createdAt DateTime @default(now())

  @@index([investigationId, type])
  @@index([investigationId, canonicalKey])
}

model EntityReference {
  id        String  @id @default(cuid())
  entityId  String
  companyId String?
  domainId  String?

  entity  Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id])
  domain  Domain?  @relation(fields: [domainId], references: [id])

  // Invariant enforced at the application layer (Prisma 5.20 has no schema-level CHECK):
  // exactly one of companyId / domainId is set, never both, never neither. ADR 0001 §4.
  // companyId/domainId deletion behavior is left at the database default (Restrict) — Company
  // and Domain have no delete pathway in the current codebase, so this isn't a live decision yet.

  @@index([entityId])
  @@index([companyId])
  @@index([domainId])
}

model Observation {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidenceId      String
  evidence        Evidence      @relation(fields: [evidenceId], references: [id], onDelete: Cascade)

  agentName   String
  type        String
  description String
  timestamp   DateTime?
  excerpt     String? // short, redacted quote — never a full message (app-layer enforced length/redaction)

  createdAt DateTime @default(now()) // append-only — see ADR 0001 §5, no updatedAt by design

  @@index([investigationId])
  @@index([evidenceId])
}

model Finding {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  confidenceType String // "observed" | "inferred" | "conclusion"
  weight         String // "low" | "medium" | "high" | "critical"
  description    String
  riskDelta      Int? // risk-direction: positive = more dangerous (ADR 0001 §1). No Finding.status —
  // see ADR 0001 §5, deliberately not added without a demonstrated need.
  observationIds String[]

  supersedesId String?  @unique
  supersedes   Finding? @relation("FindingSupersedes", fields: [supersedesId], references: [id])
  supersededBy Finding? @relation("FindingSupersedes")

  createdAt DateTime @default(now())

  @@index([investigationId])
}

model Hypothesis {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  label                String
  status               String // "supported" | "rejected" | "pending"
  supportingFindingIds String[]
  reasoning            String

  supersedesId String?     @unique
  supersedes   Hypothesis? @relation("HypothesisSupersedes", fields: [supersedesId], references: [id])
  supersededBy Hypothesis? @relation("HypothesisSupersedes")

  createdAt DateTime @default(now())

  @@index([investigationId])
}

model OutstandingQuestion {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  question   String
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  @@index([investigationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Scam pattern knowledge base (data, not code — see Agent 3)
// ─────────────────────────────────────────────────────────────────────────

enum ScamCategory {
  PONZI
  MLM
  ADVANCE_FEE
  ROMANCE_SCAM
  PHISHING
  FAKE_JOB
  FAKE_INVESTMENT
  URGENCY_TACTIC
  GUARANTEED_RETURN
  RECRUITMENT_DEPENDENCY
  OTHER
}

model ScamPattern {
  id          String       @id @default(cuid())
  name        String       @unique
  category    ScamCategory
  description String       @db.Text
  indicators  Json // keywords / regex fragments / weights used by the rule engine
  severity    Int          @default(1) // 1–5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────
// Risk signals & AI analysis trail (append-only per investigation)
// ─────────────────────────────────────────────────────────────────────────

enum RiskCategory {
  TRANSPARENCY
  IDENTITY_VERIFICATION
  REGULATORY_EVIDENCE
  REPUTATION
  TECHNICAL_SECURITY
  SUSTAINABILITY
  SCAM_PATTERN_MATCH
}

model RiskSignal {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  category RiskCategory
  score    Int // 0–100, higher = more trustworthy for that category
  weight   Float // contribution to the overall trust score
  findings Json // structured detail backing this score

  createdAt DateTime @default(now())

  @@index([investigationId, category])
}

model AIAnalysis {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  agentName    String // e.g. "FraudPatternDetectionAgent"
  providerName String // e.g. "RuleBasedFraudPatternAnalyzer" or "ClaudeNarrativeGenerator"
  rawOutput    Json
  tokensUsed   Int?
  latencyMs    Int?

  createdAt DateTime @default(now())

  @@index([investigationId, agentName])
}

// ─────────────────────────────────────────────────────────────────────────
// Reports — the user-facing deliverable
// ─────────────────────────────────────────────────────────────────────────

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

model Report {
  id              String        @id @default(cuid())
  investigationId String        @unique
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  reportNumber String @unique // human-readable, e.g. GRD-2026-000123

  trustScore      Int // 0–100
  riskLevel       RiskLevel
  confidenceLevel ConfidenceLevel

  summary            String @db.Text
  positiveSignals    Json // string[]
  warningSigns       Json // string[]
  missingInformation Json // string[]
  detailedFindings   Json // structured per-category breakdown
  recommendedActions Json // string[]

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportNumber])
}

// ─────────────────────────────────────────────────────────────────────────
// Activity logs & notifications
// ─────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  action     String // e.g. "investigation.created", "report.viewed"
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

enum NotificationType {
  INVESTIGATION_COMPLETED
  INVESTIGATION_FAILED
  WATCHLIST_ALERT
  SYSTEM
}

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String           @db.Text
  link  String?
  read  Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}
