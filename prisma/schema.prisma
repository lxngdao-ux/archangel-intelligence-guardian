// Guardian — Database Schema (v0.1)
// See docs/ARCHITECTURE.md §3 and §6 for the reasoning behind these models.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Auth (NextAuth.js standard models) + Users
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  USER
  ANALYST
  ADMINISTRATOR
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  emailVerified  DateTime?
  passwordHash   String? // null for OAuth-only accounts
  name           String?
  image          String?
  role           Role          @default(USER)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  accounts      Account[]
  sessions      Session[]
  investigations Investigation[]
  files         File[]
  notifications Notification[]
  activityLogs  ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────
// Organizations & Subscriptions (Team / Enterprise foundation)
// ─────────────────────────────────────────────────────────────────────────

enum PlanTier {
  FREE
  PRO
  TEAM
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  members   User[]
  subscription Subscription?
  investigations Investigation[]
  activityLogs ActivityLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id                   String             @id @default(cuid())
  organizationId       String             @unique
  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 PlanTier           @default(FREE)
  status               SubscriptionStatus @default(TRIALING)
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Investigations — the core object
// ─────────────────────────────────────────────────────────────────────────

enum InvestigationType {
  URL
  SCREENSHOT
  PDF
  IMAGE
  TEXT
  WHATSAPP
}

enum InvestigationStatus {
  PENDING
  COLLECTING_EVIDENCE
  ANALYZING
  COMPLETED
  FAILED
}

model Investigation {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  type      InvestigationType
  status    InvestigationStatus @default(PENDING)
  inputText String?             @db.Text // raw URL / pasted text / WhatsApp message
  failureReason String?

  files       File[]
  evidence    Evidence[]
  riskSignals RiskSignal[]
  aiAnalyses  AIAnalysis[]
  report      Report?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([organizationId])
}

// ─────────────────────────────────────────────────────────────────────────
// Files & Evidence
// ─────────────────────────────────────────────────────────────────────────

model File {
  id              String        @id @default(cuid())
  investigationId String?
  investigation   Investigation? @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  filename    String
  mimeType    String
  sizeBytes   Int
  storageKey  String // path/key within the configured StorageService
  storageUrl  String? // public/signed URL, if applicable

  uploadedAt DateTime @default(now())

  @@index([investigationId])
}

enum EvidenceKind {
  TEXT_EXTRACT
  OCR_RESULT
  WEBPAGE_CONTENT
  METADATA
  WHOIS_RECORD
  DNS_RECORD
  SCREENSHOT_ANALYSIS
}

model Evidence {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  kind       EvidenceKind
  content    Json // normalized payload — shape depends on `kind`
  sourceRef  String? // e.g. file id, URL, or "user-input"
  confidence Float    @default(1.0) // 0–1, how much the agent trusts this evidence

  createdAt DateTime @default(now())

  @@index([investigationId, kind])
}

// ─────────────────────────────────────────────────────────────────────────
// Company / Domain intelligence (compounds across investigations over time)
// ─────────────────────────────────────────────────────────────────────────

model Company {
  id             String   @id @default(cuid())
  name           String
  knownAliases   String[]
  registrationInfo Json? // registration numbers, jurisdictions, etc.
  domains        Domain[]

  firstSeenAt    DateTime @default(now())
  lastVerifiedAt DateTime?

  @@index([name])
}

model Domain {
  id        String   @id @default(cuid())
  domain    String   @unique
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])

  registeredAt DateTime?
  registrar    String?
  sslValid     Boolean?
  whoisData    Json?
  riskFlags    String[]

  lastCheckedAt DateTime @default(now())

  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────
// Scam pattern knowledge base (data, not code — see Agent 3)
// ─────────────────────────────────────────────────────────────────────────

enum ScamCategory {
  PONZI
  MLM
  ADVANCE_FEE
  ROMANCE_SCAM
  PHISHING
  FAKE_JOB
  FAKE_INVESTMENT
  URGENCY_TACTIC
  GUARANTEED_RETURN
  RECRUITMENT_DEPENDENCY
  OTHER
}

model ScamPattern {
  id          String       @id @default(cuid())
  name        String       @unique
  category    ScamCategory
  description String       @db.Text
  indicators  Json // keywords / regex fragments / weights used by the rule engine
  severity    Int          @default(1) // 1–5

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
}

// ─────────────────────────────────────────────────────────────────────────
// Risk signals & AI analysis trail (append-only per investigation)
// ─────────────────────────────────────────────────────────────────────────

enum RiskCategory {
  TRANSPARENCY
  IDENTITY_VERIFICATION
  REGULATORY_EVIDENCE
  REPUTATION
  TECHNICAL_SECURITY
  SUSTAINABILITY
  SCAM_PATTERN_MATCH
}

model RiskSignal {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  category RiskCategory
  score    Int // 0–100, higher = more trustworthy for that category
  weight   Float // contribution to the overall trust score
  findings Json // structured detail backing this score

  createdAt DateTime @default(now())

  @@index([investigationId, category])
}

model AIAnalysis {
  id              String        @id @default(cuid())
  investigationId String
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  agentName    String // e.g. "FraudPatternDetectionAgent"
  providerName String // e.g. "RuleBasedFraudPatternAnalyzer" or "ClaudeNarrativeGenerator"
  rawOutput    Json
  tokensUsed   Int?
  latencyMs    Int?

  createdAt DateTime @default(now())

  @@index([investigationId, agentName])
}

// ─────────────────────────────────────────────────────────────────────────
// Reports — the user-facing deliverable
// ─────────────────────────────────────────────────────────────────────────

enum RiskLevel {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

enum ConfidenceLevel {
  LOW
  MEDIUM
  HIGH
}

model Report {
  id              String        @id @default(cuid())
  investigationId String        @unique
  investigation   Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  reportNumber String @unique // human-readable, e.g. GRD-2026-000123

  trustScore      Int // 0–100
  riskLevel       RiskLevel
  confidenceLevel ConfidenceLevel

  summary             String   @db.Text
  positiveSignals     Json // string[]
  warningSigns        Json // string[]
  missingInformation  Json // string[]
  detailedFindings    Json // structured per-category breakdown
  recommendedActions  Json // string[]

  generatedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([reportNumber])
}

// ─────────────────────────────────────────────────────────────────────────
// Activity logs & notifications
// ─────────────────────────────────────────────────────────────────────────

model ActivityLog {
  id             String        @id @default(cuid())
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  action     String // e.g. "investigation.created", "report.viewed"
  entityType String
  entityId   String
  metadata   Json?
  ipAddress  String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

enum NotificationType {
  INVESTIGATION_COMPLETED
  INVESTIGATION_FAILED
  WATCHLIST_ALERT
  SYSTEM
}

model Notification {
  id     String            @id @default(cuid())
  userId String
  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  NotificationType
  title String
  body  String            @db.Text
  link  String?
  read  Boolean           @default(false)

  createdAt DateTime @default(now())

  @@index([userId, read])
}
