# Database
DATABASE_URL="postgresql://guardian:guardian@localhost:5432/guardian?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-32+-char-random-string"

# Google OAuth (optional in dev — credentials login works without these)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Storage (StorageService — local disk in dev; set these to switch to S3-compatible storage)
STORAGE_DRIVER="local" # "local" | "s3"
STORAGE_LOCAL_PATH="./.uploads"
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# Future AI provider wiring (unused by v0.1's rule-based agents — see docs/ROADMAP.md Phase 1)
ANTHROPIC_API_KEY=""
WHOIS_API_KEY=""
